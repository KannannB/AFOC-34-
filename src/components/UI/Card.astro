---
/**
 * Composant Card réutilisable
 * 
 * Usage:
 * <Card title="Mon Service" variant="hover">
 *   <p>Description</p>
 * </Card>
 */

interface Props {
  variant?: 'default' | 'hover' | 'bordered' | 'image';
  image?: string;
  imageAlt?: string;
  title?: string;
  badge?: string;
  href?: string;
  class?: string;
}

const { 
  variant = 'default',
  image,
  imageAlt = '',
  title,
  badge,
  href,
  class: className = ''
} = Astro.props;

// Variantes de styles
const variants = {
  default: 'bg-white p-6 rounded-lg shadow-md',
  hover: 'bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2',
  bordered: 'bg-white p-6 rounded-lg shadow-md border-t-4 border-accent',
  image: 'bg-white rounded-lg shadow-md overflow-hidden'
};

// Classes de base
const baseClasses = variants[variant];
const classes = `${baseClasses} ${className}`.trim();

// Wrapper pour lien ou div
const Tag = href ? 'a' : 'div';
const tagProps = href ? { href } : {};
---

<Tag class={`relative ${classes}`} {...tagProps}>
  {badge && (
    <span class="absolute top-4 right-4 bg-accent text-white text-xs px-3 py-1 rounded-full font-semibold">
      {badge}
    </span>
  )}
  
  {image && (
    <img 
      src={image} 
      alt={imageAlt} 
      class={variant === 'image' ? 'w-full h-48 object-cover' : 'w-full rounded-lg mb-4'}
    />
  )}
  
  <div class={variant === 'image' && image ? 'p-6' : ''}>
    {title && (
      <h3 class="text-xl font-semibold text-secondary mb-3">
        {title}
      </h3>
    )}
    
    <div class="text-text">
      <slot />
    </div>
  </div>
</Tag>