---
const { title, subtitle, cta } = Astro.props;
---
<section class="py-24 text-center px-4">
  <h1 class="text-3xl md:text-5xl font-bold">
    {title}
  </h1>

  <p class="mt-4 text-base md:text-lg max-w-xl mx-auto">
    {subtitle}
  </p>

  <a class="inline-block mt-8 px-6 py-3 bg-black text-white rounded-lg">
    {cta}
  </a>
</section>