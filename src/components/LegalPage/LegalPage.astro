---
// /src/components/LegalPage/LegalPage.astro
import siteData from '../../data/site.json';

interface Props {
  type: 'mentionsLegales' | 'politiqueConfidentialite';
}

const { type } = Astro.props;

const legalPage = siteData.legal[type];

if (!legalPage) {
  throw new Error(`Type légal invalide : ${type}`);
}

const title = legalPage.title;
const content = legalPage.content;
---

<div class="legal-hero">
  <div class="legal-hero-inner">
    <p class="legal-label">Informations légales</p>
    <h1 class="legal-title">{title}</h1>
  </div>
</div>

<section class="legal-section">
  <div class="legal-content">
    {
      content.map((section) => (
        <article class="legal-card">
          <h2 class="legal-card-title">{section.sectionTitle}</h2>
          <p class="legal-card-text">{section.text}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .legal-hero {
    background-color: var(--color-bleu);
    padding: 3.5rem 1.5rem 2.75rem;
    position: relative;
    overflow: hidden;
  }
  .legal-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: 260px;
    height: 260px;
    background: var(--color-rouge);
    opacity: 0.08;
    border-radius: 50%;
    transform: translate(30%, 40%);
  }
  .legal-hero-inner {
    max-width: 760px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .legal-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-rouge);
    margin-bottom: 0.6rem;
  }
  .legal-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
  }

  .legal-section {
    padding: 3.5rem 1.5rem 5rem;
    background: var(--color-background);
  }
  .legal-content {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .legal-card {
    background: #ffffff;
    border: 1px solid #e8ecf0;
    border-left: 4px solid var(--color-rouge);
    border-radius: 12px;
    padding: 1.75rem 2rem;
  }
  .legal-card-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-bleu);
    margin: 0 0 0.75rem;
  }
  .legal-card-text {
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
  }
</style>
