---
import siteData from '../../data/site.json';
import logo from '../../img/LogoAfoc.png';
---

<header class="flex items-center justify-between p-4 bg-white text-bleu">
  <a href={siteData?.header?.logoLink || '/'} class="transition-opacity hover:opacity-90">
    <img src={logo.src} alt={siteData?.header?.logo || 'AFOC 34'} class="w-auto h-10" />
    <div class="text-xl font-bold logo">{siteData?.header?.logo || 'AFOC 34'}</div>
  </a>

  <nav>
    <ul class="flex space-x-4">
      {
        /* Le ?. empêche l'erreur si navLinks n'est pas encore chargé */
        siteData?.header?.navLinks?.map((link) => (
          <li>
            <a href={link.url} class="font-bold transition-all text-text-bleu hover:underline">
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
