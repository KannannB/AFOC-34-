---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page introuvable - AFOC 34">
  <section class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="text-center max-w-lg mx-auto px-6 py-16">
      <div class="text-8xl font-serif font-bold text-[var(--color-bleu)] mb-4">404</div>
      <div class="w-16 h-1 bg-[var(--color-rouge)] mx-auto mb-8"></div>
      <h1 class="text-2xl font-serif font-bold text-[var(--color-bleu)] mb-4">
        Page introuvable
      </h1>
      <p class="text-gray-600 leading-relaxed mb-8">
        La page que vous recherchez n'existe pas ou a été déplacée.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
          href="/"
          style="background: var(--color-bleu)"
          class="inline-block text-white font-bold px-8 py-3 rounded-xl transition-all hover:opacity-90"
        >
          Retour à l'accueil
        </a>
        
          href="/contact"
          style="border: 2px solid var(--color-bleu); color: var(--color-bleu)"
          class="inline-block font-bold px-8 py-3 rounded-xl transition-all hover:opacity-80"
        >
          Nous contacter
        </a>
      </div>
    </div>
  </section>
</Layout>
