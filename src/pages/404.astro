---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page introuvable - AFOC 34">
  <section class="flex items-center justify-center min-h-screen bg-gray-50">
    <div class="max-w-lg px-6 py-16 mx-auto text-center">
      <div class="text-8xl font-serif font-bold text-[var(--color-bleu)] mb-4">404</div>
      <div class="w-16 h-1 bg-[var(--color-rouge)] mx-auto mb-8"></div>
      <h1 class="text-2xl font-serif font-bold text-[var(--color-bleu)] mb-4">Page introuvable</h1>
      <p class="mb-8 leading-relaxed text-gray-600">
        La page que vous recherchez n existe pas ou a ete déplacée.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="/"
          style="background: var(--color-bleu)"
          class="inline-block px-8 py-3 font-bold text-white transition-all rounded-xl hover:opacity-90"
          >Retour a l accueil</a
        >
        <a
          href="/contact"
          style="border: 2px solid var(--color-bleu); color: var(--color-bleu)"
          class="inline-block px-8 py-3 font-bold transition-all rounded-xl hover:opacity-80"
          >Nous contacter</a
        >
      </div>
    </div>
  </section>
</Layout>
