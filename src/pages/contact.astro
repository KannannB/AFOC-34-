---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/UI/ContactForm.astro';
import siteData from '../data/site.json';

const contact = siteData.contact;
const fullAddress = contact.details.address;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
---

<Layout title={contact.title} description={contact.description}>
  <section class="container mx-auto py-20 px-6">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-primary">{contact.title}</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">{contact.description}</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-16">
      <div class="space-y-8">
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 shadow-sm">
            <h2 class="text-lg font-bold mb-2 text-secondary">📍 Notre Siège</h2>
            <p class="text-gray-700 text-sm leading-relaxed">{contact.details.address}</p>
          </div>

          <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 shadow-sm">
            <h2 class="text-lg font-bold mb-2 text-secondary">📞 Nous joindre</h2>
            <p class="text-gray-700 text-sm"><strong>Tél :</strong> {contact.details.phone}</p>
            <p class="text-gray-700 text-sm"><strong>Email :</strong> {contact.details.email}</p>
          </div>
        </div>

        <div class="space-y-6">
          <div
            class="rounded-2xl overflow-hidden shadow-lg border-2 border-gray-100 bg-gray-200 h-80"
          >
            <img
              src="https://static-maps.yandex.ru/1.x/?lang=fr_FR&ll=3.8965,43.6015&z=15&l=map&size=650,350&pt=3.8965,43.6015,pm2rdm"
              alt="Plan d'accès AFOC 34"
              class="w-full h-full object-cover"
            />
          </div>

          <div class="flex flex-col items-center gap-4">
            <a
              href={mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 bg-primary text-white px-8 py-4 rounded-full font-bold shadow-xl hover:bg-secondary hover:-translate-y-1 transition-all"
            >
              <span>📍 Cliquez pour ouvrir l'itinéraire</span>
            </a>

            <p class="text-xs text-gray-500 text-center max-w-xs italic">
              L'itinéraire s'ouvrira directement dans votre application GPS (Google Maps, Waze,
              Apple Maps).
            </p>
          </div>
        </div>

        <div class="bg-blue-50 p-6 rounded-2xl border-l-4 border-accent">
          <h2 class="text-lg font-bold mb-2 text-accent">🚍 Accès & Transports</h2>
          <p class="text-gray-700 text-sm leading-relaxed">{contact.details.access}</p>
        </div>
      </div>

      <div class="relative">
        <div class="sticky top-8">
          <h2 class="text-2xl font-bold mb-6 text-primary italic">Envoyer un message</h2>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Layout>
