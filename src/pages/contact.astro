---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/UI/ContactForm.astro';
import AideJuridique from '../components/UI/AideJuridique.astro';
import siteData from '../data/site.json';
const contact = siteData.contact;
const fullAddress = contact.details.address;
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(fullAddress);
---

<Layout title={contact.title} description={contact.description}>
  <div class="page-hero">
    <div class="page-hero-inner">
      <p class="page-hero-label">Nous joindre</p>
      <h1>{contact.title}</h1>
      <p class="page-hero-sub">{contact.description}</p>
    </div>
  </div>

  <section class="container px-6 py-20 mx-auto">
    <div class="grid gap-16 lg:grid-cols-2">
      <div class="space-y-8">
        <div class="grid gap-6 md:grid-cols-2">
          <div class="p-6 border border-gray-100 shadow-sm bg-gray-50 rounded-2xl">
            <h2 class="mb-2 text-lg font-bold text-secondary">📍 Notre Siège</h2>
            <p class="text-sm leading-relaxed text-gray-700">{contact.details.address}</p>
          </div>
          <div class="p-6 border border-gray-100 shadow-sm bg-gray-50 rounded-2xl">
            <h2 class="mb-2 text-lg font-bold text-secondary">📞 Nous joindre</h2>
            <p class="text-sm text-gray-700"><strong>Tél :</strong> {contact.details.phone}</p>
            <p class="text-sm text-gray-700"><strong>Email :</strong> {contact.details.email}</p>
          </div>
        </div>
        <div class="space-y-6">
          <div
            class="overflow-hidden bg-gray-200 border-2 border-gray-100 shadow-lg rounded-2xl h-80"
          >
            <img
              src="https://static-maps.yandex.ru/1.x/?lang=fr_FR&ll=3.8965,43.6015&z=15&l=map&size=650,350&pt=3.8965,43.6015,pm2rdm"
              width="650"
              height="350"
              loading="lazy"
              alt="Plan d'accès AFOC 34"
              class="object-cover w-full h-full"
            />
          </div>
          <div class="flex flex-col items-center gap-4">
            <a
              href={mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 px-8 py-4 font-bold text-white transition-all rounded-full shadow-xl bg-primary hover:bg-secondary hover:-translate-y-1"
            >
              <span>📍 Cliquez pour ouvrir l'itinéraire</span>
            </a>
            <p class="max-w-xs text-xs italic text-center text-gray-500">
              L'itinéraire s'ouvrira directement dans votre application GPS (Google Maps, Waze,
              Apple Maps).
            </p>
          </div>
        </div>
        <div class="p-6 border-l-4 bg-blue-50 rounded-2xl border-accent">
          <h2 class="mb-2 text-lg font-bold text-accent">🚍 Accès & Transports</h2>
          <p class="text-sm leading-relaxed text-gray-700">{contact.details.access}</p>
        </div>
      </div>
      <div class="relative">
        <div class="sticky top-8">
          <h2 class="mb-6 text-2xl italic font-bold text-primary">Envoyer un message</h2>
          <AideJuridique />
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: #1b5162;
    padding: 5rem 1.5rem 4rem;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    right: -120px;
    top: -120px;
    width: 320px;
    height: 320px;
    background: var(--color-rouge);
    opacity: 0.08;
    border-radius: 50%;
  }
  .page-hero-inner {
    max-width: 760px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .page-hero-label {
    color: var(--color-rouge);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .page-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.1;
    color: white;
    margin-bottom: 1rem;
    font-weight: 400;
  }
  .page-hero-sub {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.05rem;
    line-height: 1.8;
    max-width: 620px;
    margin: 0;
  }
</style>
