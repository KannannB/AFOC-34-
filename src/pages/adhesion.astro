---
import Layout from '../layouts/Layout.astro';

const netlifyFormAttrs: Record<string, string | boolean> = {
  netlify: true,
  'netlify-honeypot': 'bot-field',
  'data-netlify-recaptcha': 'true',
};
---

<Layout
  title="Adhérer à l'AFOC 34"
  description="Rejoignez l'AFOC 34 pour défendre vos droits de consommateur et de locataire."
>
  <div class="page-hero">
    <div class="page-hero-inner">
      <p class="page-hero-label">Rejoignez-nous</p>
      <h1>Adhésion AFOC 34</h1>
      <p class="page-hero-sub">Ensemble, défendons vos droits au quotidien.</p>
    </div>
  </div>

  <section class="py-20 bg-gray-50">
    <div class="container max-w-5xl px-6 mx-auto">
      <div class="grid gap-12 lg:grid-cols-3">
        <div class="p-8 bg-white border border-gray-100 shadow-xl lg:col-span-2 rounded-3xl">
          <form
            name="adhesion"
            method="POST"
            {...netlifyFormAttrs}
            action="/success"
            class="space-y-6"
          >
            <input type="hidden" name="form-name" value="adhesion" />
            <p class="hidden">
              <label>Ne pas remplir si vous êtes humain : <input name="bot-field" /></label>
            </p>

            <h2 class="pb-2 mb-6 text-2xl font-bold border-b" style="color: #1b5162;">
              Vos Informations
            </h2>

            <div class="grid gap-6 md:grid-cols-2">
              <div>
                <label class="block mb-2 text-sm font-bold">Prénom</label>
                <input
                  type="text"
                  name="firstname"
                  required
                  class="w-full p-3 border border-gray-300 outline-none rounded-xl focus:ring-2 focus:ring-primary"
                />
              </div>
              <div>
                <label class="block mb-2 text-sm font-bold">Nom</label>
                <input
                  type="text"
                  name="lastname"
                  required
                  class="w-full p-3 border border-gray-300 outline-none rounded-xl focus:ring-2 focus:ring-primary"
                />
              </div>
            </div>

            <div class="grid gap-6 md:grid-cols-2">
              <div>
                <label class="block mb-2 text-sm font-bold">Email</label>
                <input
                  type="email"
                  name="email"
                  required
                  class="w-full p-3 border border-gray-300 outline-none rounded-xl focus:ring-2 focus:ring-primary"
                />
              </div>
              <div>
                <label class="block mb-2 text-sm font-bold">Téléphone</label>
                <input
                  type="tel"
                  name="phone"
                  class="w-full p-3 border border-gray-300 outline-none rounded-xl focus:ring-2 focus:ring-primary"
                />
              </div>
            </div>

            <div>
              <label class="block mb-2 text-sm font-bold">Adresse postale complète</label>
              <textarea
                name="address"
                rows="2"
                class="w-full p-3 border border-gray-300 outline-none rounded-xl focus:ring-2 focus:ring-primary"
              ></textarea>
            </div>

            <div class="grid gap-6 md:grid-cols-2">
              <div>
                <label class="block mb-2 text-sm font-bold">Votre situation</label>
                <select
                  name="status"
                  class="w-full p-3 border border-gray-300 outline-none rounded-xl"
                >
                  <option value="salarie">Salarié secteur privé/public</option>
                  <option value="retraite">Retraité</option>
                  <option value="etudiant">Étudiant / Lycéen</option>
                  <option value="sans-profession">Sans profession</option>
                  <option value="autre">Autre</option>
                </select>
              </div>
              <div>
                <label class="block mb-2 text-sm font-bold">Votre logement</label>
                <select
                  name="housing"
                  class="w-full p-3 border border-gray-300 outline-none rounded-xl"
                >
                  <option value="locataire-hlm">Locataire HLM</option>
                  <option value="locataire-prive">Locataire parc privé</option>
                  <option value="proprietaire">Propriétaire</option>
                </select>
              </div>
            </div>

            <div class="flex items-start mb-2">
              <div class="flex items-center h-5">
                <input
                  id="rgpd-adhesion"
                  name="rgpd_consent"
                  type="checkbox"
                  required
                  class="w-4 h-4 border border-gray-300 rounded bg-gray-50 focus:ring-3 focus:ring-primary"
                />
              </div>
              <label for="rgpd-adhesion" class="ml-3 text-sm text-gray-600">
                J'accepte que mes données soient traitées par l'AFOC 34 dans le cadre de ma demande
                d'adhésion.
                <a href="/politique-confidentialite" class="text-primary hover:underline"
                  >Voir notre politique de confidentialité</a
                >.
              </label>
            </div>

            <div data-netlify-recaptcha="true"></div>

            <button
              type="submit"
              class="w-full py-4 font-bold text-white transition-all transform shadow-lg bg-accent hover:bg-secondary rounded-xl hover:-translate-y-1"
            >
              Valider mon adhésion
            </button>
          </form>
        </div>

        <div class="space-y-6">
          <div class="p-8 text-white shadow-lg bg-primary rounded-3xl">
            <h3 class="mb-4 text-xl font-bold">Pourquoi nous rejoindre ?</h3>
            <ul class="space-y-4 text-sm">
              <li class="flex items-start gap-2">
                <span class="text-lg text-accent">✓</span>
                <span>Traitement prioritaire de vos litiges.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-lg text-accent">✓</span>
                <span>Accès à nos dossiers d'expertise Logement & Consommation.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-lg text-accent">✓</span>
                <span>Soutien à une association indépendante de défense des citoyens.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background-color: var(--color-bleu);
    padding: 4rem 1.5rem 3rem;
    position: relative;
    overflow: hidden;
  }
  .page-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: 300px;
    height: 300px;
    background: var(--color-rouge);
    opacity: 0.08;
    border-radius: 50%;
    transform: translate(30%, 40%);
  }
  .page-hero-inner {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .page-hero-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-rouge);
    margin-bottom: 0.75rem;
  }
  .page-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.1;
    color: white;
    margin-bottom: 1rem;
    font-weight: 400;
  }
  .page-hero-sub {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.05rem;
    max-width: 560px;
    line-height: 1.7;
    margin: 0;
  }
</style>
