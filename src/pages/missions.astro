---
import Layout from '../layouts/Layout.astro';
import siteData from '../data/site.json';
import Card from '../components/UI/Card.astro';

const { services } = siteData;
---

<Layout
  title="Nos Missions - AFOC 34"
  description="Découvrez nos domaines d'intervention : logement, consommation et services publics."
>
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-6">
      <h1 class="text-4xl font-bold text-primary mb-6">Nos Missions</h1>
      <p class="text-xl text-gray-600 mb-12 max-w-3xl">
        L'AFOC 34 accompagne ses adhérents dans la résolution de litiges quotidiens et siège dans de
        nombreuses instances pour défendre vos intérêts.
      </p>

      <div class="grid gap-8">
        {
          services.map((service) => (
            <div class="bg-white p-8 rounded-2xl shadow-sm border-l-8 border-accent flex flex-col md:flex-row md:items-center justify-between">
              <div class="md:w-2/3">
                <h2 class="text-2xl font-bold text-secondary mb-4">{service.title}</h2>
                <p class="text-gray-700 text-lg">{service.desc}</p>
              </div>
              <div class="mt-6 md:mt-0">
                <a href="/contact" class="text-accent font-bold hover:underline">
                  Besoin d'aide sur ce sujet ? →
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
