---
import Layout from '../layouts/Layout.astro';
import siteData from '../data/site.json';

const title = siteData.about.title;
const description = siteData.about.description;
const content = siteData.about.content;
const hero = siteData.hero;
import Button from '../components/UI/Button.astro';
import Card from '../components/UI/Card.astro';
---

<Layout title={title} description={description}>
  <section class="py-16 bg-white">
    <div class="max-w-5xl px-6 mx-auto lg:px-12">
      <div class="mb-14">
        <h1 class="mb-6 text-4xl font-bold md:text-5xl text-secondary">
          {title}
        </h1>

        <p class="max-w-3xl text-lg leading-relaxed text-gray-600">
          {description}
        </p>
      </div>

      <div class="grid gap-8">
        {
          content.map((section) => (
            <article class="p-8 transition border border-gray-100 shadow-sm bg-gray-50 rounded-2xl hover:shadow-md">
              <h2 class="mb-4 text-2xl font-semibold text-secondary">{section.sectionTitle}</h2>

              <p class="text-lg leading-relaxed text-gray-700">{section.text}</p>
            </article>
          ))
        }
      </div>

      <div class="p-10 mt-16 text-white bg-bleu from-primary to-secondary rounded-2xl">
        <h2 class="mb-4 text-3xl font-bold">Besoin d’aide ou d’informations ?</h2>

        <p class="mb-6 text-lg leading-relaxed text-gray-100">
          L’AFOC 34 accompagne les consommateurs et les locataires dans leurs démarches, leurs
          litiges et la défense de leurs droits au quotidien.
        </p>

        <Button href={hero.cta.url} variant="accent" size="lg">
          {hero.cta.label}
        </Button>
      </div>
    </div>
  </section>
</Layout>
