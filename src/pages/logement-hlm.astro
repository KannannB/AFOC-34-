---
import Layout from '../layouts/Layout.astro';
import ArticleList from '../components/Articles/ArticleList.astro';
---

<Layout
  title="Logement & HLM : charges, bail, état des lieux, loyers"
  description="Charges, état des lieux, bail, logement social, encadrement des loyers : les dossiers de l'AFOC 34 pour défendre vos droits de locataire dans l'Hérault."
>
  <ArticleList
    collection="logement"
    basePath="/logement"
    tag="Logement"
    heroLabel="Nos dossiers"
    heroTitle="Logement & HLM"
    heroSub="Retrouvez tous nos articles et conseils pour défendre vos droits en matière de logement, de bail et de relations avec les bailleurs."
  />
</Layout>
