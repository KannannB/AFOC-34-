---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('consommation');
const articlesTriés = articles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Consommation">
  <!-- Hero section -->
  <div class="hero-consommation">
    <div class="hero-inner">
      <p class="hero-label">Nos dossiers</p>
      <h1>Consommation</h1>
      <p class="hero-sub">
        Retrouvez tous nos articles, guides et conseils pour défendre vos droits en tant que
        consommateur.
      </p>
    </div>
  </div>

  <!-- Grille d'articles -->
  <section class="articles-section">
    <div class="articles-grid">
      {
        articlesTriés.length === 0 ? (
          <p class="empty">Aucun article publié pour le moment.</p>
        ) : (
          articlesTriés.map((article, i) => (
            <a
              href={`/consommation/${article.id}`}
              class="card"
              style={`animation-delay: ${i * 80}ms`}
            >
              <div class="card-top">
                <span class="card-tag">Consommation</span>
                <span class="card-date">
                  {article.data.date.toLocaleDateString('fr-FR', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                  })}
                </span>
              </div>
              <h2 class="card-title">{article.data.title}</h2>
              {article.data.description && <p class="card-desc">{article.data.description}</p>}
              <div class="card-footer">
                <span class="card-link">
                  Lire l'article <span class="arrow">→</span>
                </span>
              </div>
            </a>
          ))
        )
      }
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero-consommation {
    background-color: var(--color-bleu);
    padding: 4rem 1.5rem 3rem;
    position: relative;
    overflow: hidden;
  }

  .hero-consommation::after {
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: 300px;
    height: 300px;
    background: var(--color-rouge);
    opacity: 0.08;
    border-radius: 50%;
    transform: translate(30%, 40%);
  }

  .hero-inner {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-rouge);
    margin-bottom: 0.75rem;
  }

  .hero-consommation h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.2rem);
    color: #ffffff;
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  .hero-sub {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.05rem;
    max-width: 560px;
    line-height: 1.7;
    margin: 0;
  }

  /* Section articles */
  .articles-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 5rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  /* Card */
  .card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #e8ecf0;
    border-radius: 10px;
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
    animation: fadeUp 0.4s ease both;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(27, 81, 98, 0.12);
    border-color: var(--color-bleu);
  }

  .card:hover .arrow {
    transform: translateX(4px);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .card-tag {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-rouge);
    background: rgba(240, 54, 72, 0.08);
    padding: 0.25rem 0.6rem;
    border-radius: 20px;
  }

  .card-date {
    font-size: 0.78rem;
    color: #9ca3af;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-bleu);
    line-height: 1.4;
    margin: 0 0 0.75rem;
  }

  .card-desc {
    font-size: 0.9rem;
    color: #6b7280;
    line-height: 1.65;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid #f3f4f6;
  }

  .card-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-bleu);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .empty {
    color: #9ca3af;
    font-style: italic;
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
