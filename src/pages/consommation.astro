---
import Layout from '../layouts/Layout.astro';
import ArticleList from '../components/Articles/ArticleList.astro';
---

<Layout
  title="Consommation : arnaques, opérateurs, banque, assurance"
  description="Arnaques, démarchage abusif, litiges opérateurs, banque et assurance : les dossiers et conseils de l'AFOC 34 pour défendre vos droits de consommateur."
>
  <ArticleList
    collection="consommation"
    basePath="/consommation"
    tag="Consommation"
    heroLabel="Nos dossiers"
    heroTitle="Consommation"
    heroSub="Retrouvez tous nos articles, guides et conseils pour défendre vos droits en tant que consommateur."
  />
</Layout>
