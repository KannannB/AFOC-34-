---
import Layout from '../layouts/Layout.astro';
import siteData from '../data/site.json';

const title = siteData.seo.defaultTitle;
const description = siteData.seo.defaultDescription;
const hero = siteData.hero;
const permanences = siteData.permanences;
---

<Layout title={title} description={description}>
  <!-- HERO ASYMÉTRIQUE -->
  <section class="hero">
    <div class="hero-decor-ring-1"></div>
    <div class="hero-decor-ring-2"></div>

    <div class="hero-grid">
      <div class="hero-left">
        <div class="hero-badge">
          <span class="hero-badge-dot"></span>
          <span>Association agréée depuis 1975</span>
        </div>
        <h1 class="hero-title">
          <span class="hero-title-brand">AFOC 34</span>
          <span class="hero-title-sub">Défense des</span>
          <span class="hero-title-accent">Consommateurs</span>
          <span class="hero-title-sub">& Locataires de l'Hérault</span>
        </h1>
        <p class="hero-subtitle">{hero.subtitle}</p>
        <div class="hero-actions">
          <a href="/contact" class="btn-primary">Nous contacter</a>
          <a href="/about" class="btn-ghost">En savoir plus →</a>
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-card">
          <p class="hero-card-label">Nos chiffres</p>
          <div class="hero-stats">
            <div class="hero-stat">
              <span class="hero-stat-val" data-count="1975" data-suffix="">1975</span>
              <span class="hero-stat-label">Fondée en</span>
            </div>
            <div class="hero-stat">
              <span class="hero-stat-val accent" data-count="3" data-suffix="">3</span>
              <span class="hero-stat-label">Villes</span>
            </div>
            <div class="hero-stat">
              <span class="hero-stat-val" data-count="5" data-suffix="">5</span>
              <span class="hero-stat-label">Axes d'action</span>
            </div>
            <div class="hero-stat">
              <span class="hero-stat-val accent" data-count="100" data-suffix="%">100%</span>
              <span class="hero-stat-label">Indépendant</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MISSIONS -->
  <section class="missions reveal">
    <div class="container">
      <div class="section-header">
        <p class="section-label">Ce que nous faisons</p>
        <h2 class="section-title">Nos domaines d'intervention</h2>
        <p class="section-sub">Nous vous accompagnons dans tous vos litiges du quotidien.</p>
      </div>
      <div class="missions-grid">
        <a href="/logement-hlm" class="mission-card reveal-card">
          <div class="mission-bar" style="background: #1b5162;"></div>
          <div class="mission-icon" style="background: rgba(27,81,98,0.1);">🏠</div>
          <h3 class="mission-title">Logement & HLM</h3>
          <p class="mission-desc">
            Charges, état des lieux, baux et commissions de concertation locative.
          </p>
          <span class="mission-link">Découvrir →</span>
        </a>
        <a href="/consommation" class="mission-card reveal-card">
          <div class="mission-bar" style="background: #f03648;"></div>
          <div class="mission-icon" style="background: rgba(240,54,72,0.1);">🛒</div>
          <h3 class="mission-title">Consommation</h3>
          <p class="mission-desc">
            Arnaques, litiges opérateurs, démarchage abusif, banques et assurances.
          </p>
          <span class="mission-link">Découvrir →</span>
        </a>
        <a href="/conseils" class="mission-card reveal-card">
          <div class="mission-bar" style="background: #1b5162;"></div>
          <div class="mission-icon" style="background: rgba(27,81,98,0.1);">🛡️</div>
          <h3 class="mission-title">Conseils</h3>
          <p class="mission-desc">CAF, CPAM, démarches administratives et droits des usagers.</p>
          <span class="mission-link">Découvrir →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ENGAGEMENT -->
  <section class="engagement reveal">
    <div class="container">
      <div class="engagement-grid">
        <div class="engagement-left">
          <p class="section-label-light">Notre engagement</p>
          <h2 class="engagement-title">Une association indépendante à vos côtés</h2>
          <p class="engagement-desc">
            L'AFOC 34 agit depuis 1975 pour défendre les droits des consommateurs et des locataires
            de l'Hérault. Nos bénévoles vous accompagnent gratuitement dans vos démarches.
          </p>
          <ul class="engagement-list">
            <li><span class="check">✓</span> Information sur vos droits</li>
            <li><span class="check">✓</span> Accompagnement amiable</li>
            <li><span class="check">✓</span> Représentation dans les commissions</li>
            <li><span class="check">✓</span> Défense collective des consommateurs</li>
          </ul>
        </div>
        <div class="engagement-right">
          <div class="contact-card reveal-card">
            <p class="contact-card-title">Nous contacter</p>
            <p class="contact-info">📍 {siteData.contact.details.address}</p>
            <p class="contact-info">📞 {siteData.contact.details.phone}</p>
            <p class="contact-info">✉️ {siteData.contact.details.email}</p>
            <p class="contact-info">🚊 {siteData.contact.details.access}</p>
            <a href="/contact" class="contact-btn">Prendre contact</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PERMANENCES -->
  <section class="permanences reveal">
    <div class="container">
      <div class="section-header">
        <p class="section-label">Près de chez vous</p>
        <h2 class="section-title">{permanences.title}</h2>
        <p class="section-sub">{permanences.description}</p>
      </div>
      <div class="permanences-grid">
        {
          permanences.locations.map((loc, i) => (
            <div
              class="permanence-card reveal-card"
              style={'animation-delay:' + String(i * 100) + 'ms'}
            >
              <h4 class="permanence-city">{loc.city}</h4>
              <p class="permanence-address">📍 {loc.address}</p>
              <p class="permanence-schedule">🕐 {loc.schedule}</p>
            </div>
          ))
        }
      </div>
      <div class="permanences-cta">
        <a href="/permanences" class="btn-outline">Voir toutes les permanences →</a>
      </div>
    </div>
  </section>

  <!-- CTA ADHÉSION -->
  <section class="cta reveal">
    <div class="container">
      <div class="cta-box">
        <div class="cta-decor-1"></div>
        <div class="cta-decor-2"></div>
        <div class="cta-inner">
          <p class="section-label-light">Rejoignez-nous</p>
          <h2 class="cta-title">Soutenez l'AFOC 34, adhérez !</h2>
          <p class="cta-desc">
            Plus nous sommes nombreux, plus notre voix pèse face aux bailleurs et aux grandes
            entreprises.
          </p>
          <a href="/adhesion" class="btn-accent">Comment adhérer ?</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Compteur animé sur les stats ──
  function animateCount(el: Element) {
    const target = parseInt((el as HTMLElement).dataset.count || '0');
    const suffix = (el as HTMLElement).dataset.suffix || '';

    if (prefersReducedMotion) {
      el.textContent = target + suffix;
      return;
    }

    const duration = 1500;
    const start = performance.now();
    const startVal = target > 100 ? target - 50 : 0;

    function update(now: number) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.floor(startVal + (target - startVal) * eased);
      el.textContent = current + suffix;
      if (progress < 1) requestAnimationFrame(update);
    }
    requestAnimationFrame(update);
  }

  // ── Intersection Observer pour scroll reveal ──
  if (prefersReducedMotion) {
    document.querySelectorAll('.reveal, .reveal-card').forEach((el) => el.classList.add('visible'));
  } else {
    const observerOptions = { threshold: 0.15, rootMargin: '0px 0px -50px 0px' };

    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('.reveal, .reveal-card').forEach((el) => {
      revealObserver.observe(el);
    });
  }

  // ── Compteur au scroll ──
  const statsObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.querySelectorAll('[data-count]').forEach(animateCount);
          statsObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.5 }
  );

  const heroCard = document.querySelector('.hero-card');
  if (heroCard) statsObserver.observe(heroCard);

  // ── Ripple effect sur les boutons ──
  if (!prefersReducedMotion) {
    document.querySelectorAll('.btn-primary, .btn-accent').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const mouseEvent = e as MouseEvent;
        const ripple = document.createElement('span');
        const rect = target.getBoundingClientRect();
        ripple.style.cssText =
          'position:absolute;border-radius:50%;background:rgba(255,255,255,0.3);transform:scale(0);animation:ripple 0.6s linear;pointer-events:none;';
        const size = Math.max(rect.width, rect.height);
        ripple.style.width = ripple.style.height = size + 'px';
        ripple.style.left = mouseEvent.clientX - rect.left - size / 2 + 'px';
        ripple.style.top = mouseEvent.clientY - rect.top - size / 2 + 'px';
        target.style.position = 'relative';
        target.style.overflow = 'hidden';
        target.appendChild(ripple);
        setTimeout(() => ripple.remove(), 600);
      });
    });
  }

  // ── Header sticky effet au scroll ──
  const header = document.querySelector('header') as HTMLElement | null;
  if (header) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        header.style.boxShadow = '0 4px 24px rgba(27,81,98,0.12)';
        header.style.backdropFilter = 'blur(8px)';
      } else {
        header.style.boxShadow = 'none';
        header.style.backdropFilter = 'none';
      }
    });
  }
</script>

<style>
  /* ── REVEAL ANIMATIONS ── */
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-card {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }
  .reveal-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes ripple {
    to {
      transform: scale(4);
      opacity: 0;
    }
  }

  /* ── HERO ── */
  .hero {
    background: #1b5162;
    padding: 3rem 2rem 0;
    position: relative;
    overflow: hidden;
  }
  .hero-decor-ring-1 {
    position: absolute;
    top: -80px;
    right: -80px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    border: 50px solid rgba(240, 54, 72, 0.12);
  }
  .hero-decor-ring-2 {
    position: absolute;
    bottom: 30px;
    left: -40px;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    border: 30px solid rgba(255, 255, 255, 0.05);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: end;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .hero-left {
    padding-bottom: 3rem;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(240, 54, 72, 0.15);
    border: 1px solid rgba(240, 54, 72, 0.35);
    border-radius: 999px;
    padding: 5px 14px;
    margin-bottom: 1.5rem;
  }
  .hero-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f03648;
    animation: pulse 2s infinite;
  }
  .hero-badge span {
    font-size: 11px;
    font-weight: 600;
    color: #fca5a5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.25;
    margin: 0 0 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .hero-title-accent {
    color: #f03648;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 800;
  }
  .hero-title-light {
    color: rgba(255, 255, 255, 0.6);
    display: block;
    font-size: 0.85em;
  }
  .hero-subtitle {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.95rem;
    line-height: 1.75;
    margin: 0 0 2rem;
    max-width: 380px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Hero card stats */
  .hero-right {
    padding-bottom: 2.5rem;
  }
  .hero-card {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 1.75rem;
  }
  .hero-card-label {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 1.25rem;
  }
  .hero-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .hero-stat-val {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 800;
    color: #fff;
    line-height: 1;
  }
  .hero-stat-val.accent {
    color: #f03648;
  }
  .hero-stat-label {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ── BUTTONS ── */
  .btn-primary {
    background: #f03648;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.7rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    transition:
      opacity 0.2s,
      transform 0.2s;
    display: inline-block;
  }
  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .btn-ghost {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.7rem 0;
    transition: color 0.2s;
  }
  .btn-ghost:hover {
    color: #fff;
  }

  .btn-outline {
    border: 2px solid #1b5162;
    color: #1b5162;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.7rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    display: inline-block;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .btn-outline:hover {
    background: #1b5162;
    color: #fff;
  }

  .btn-accent {
    background: #f03648;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.8rem 2rem;
    border-radius: 999px;
    text-decoration: none;
    display: inline-block;
    transition:
      opacity 0.2s,
      transform 0.2s;
  }
  .btn-accent:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  /* ── CONTAINER ── */
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── SECTION HEADERS ── */
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .section-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #f03648;
    margin-bottom: 0.5rem;
  }
  .section-label-light {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 0.5rem;
  }
  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: #1b5162;
    margin-bottom: 0.75rem;
  }
  .section-sub {
    color: #6b7280;
    font-size: 1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  /* ── MISSIONS ── */
  .missions {
    padding: 5rem 0;
    background: #fff;
  }
  .missions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .mission-card {
    background: #fff;
    border: 1px solid #e8ecf0;
    border-radius: 14px;
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }
  .mission-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(27, 81, 98, 0.12);
    border-color: #1b5162;
  }
  .mission-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .mission-card:hover .mission-bar {
    transform: scaleX(1);
  }
  .mission-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }
  .mission-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #1b5162;
    margin-bottom: 0.6rem;
  }
  .mission-desc {
    font-size: 0.88rem;
    color: #6b7280;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    flex: 1;
  }
  .mission-link {
    font-size: 0.82rem;
    font-weight: 700;
    color: #f03648;
    transition: gap 0.2s;
  }

  /* ── ENGAGEMENT ── */
  .engagement {
    background: #1b5162;
    padding: 5rem 0;
  }
  .engagement-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .engagement-title {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .engagement-desc {
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.8;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }
  .engagement-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .engagement-list li {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .check {
    color: #f03648;
    font-weight: 800;
    font-size: 1rem;
  }
  .contact-card {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: background 0.2s;
  }
  .contact-card:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .contact-card-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.25rem;
  }
  .contact-info {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.87rem;
    line-height: 1.5;
  }
  .contact-btn {
    display: inline-block;
    margin-top: 0.5rem;
    background: #f03648;
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.65rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    text-align: center;
    transition:
      opacity 0.2s,
      transform 0.2s;
  }
  .contact-btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  /* ── PERMANENCES ── */
  .permanences {
    padding: 5rem 0;
    background: #f9fafb;
  }
  .permanences-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }
  .permanence-card {
    background: #fff;
    border: 1px solid #e8ecf0;
    border-radius: 14px;
    padding: 1.75rem;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .permanence-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(27, 81, 98, 0.1);
  }
  .permanence-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f03648;
    margin-bottom: 1rem;
  }
  .permanence-city {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #1b5162;
    margin-bottom: 0.6rem;
  }
  .permanence-address {
    font-size: 0.85rem;
