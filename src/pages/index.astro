---
import Layout from '../layouts/Layout.astro';
import siteData from '../data/site.json';
import Button from '../components/UI/Button.astro';
import Card from '../components/UI/Card.astro';

const title = siteData.seo.defaultTitle;
const description = siteData.seo.defaultDescription;
const hero = siteData.hero;
const services = siteData.services;
const permanences = siteData.permanences;

const icones = {
  'home-icon': '🏠',
  'shopping-cart-icon': '🛒',
  'shield-check-icon': '🛡️',
};

const stats = [
  { valeur: '1975', label: 'Année de création' },
  { valeur: '3', label: 'Villes couvertes' },
  { valeur: '5', label: "Axes d'intervention" },
  { valeur: '100%', label: 'Indépendant' },
];
---

<Layout title={title} description={description}>
  <!-- HERO -->
  <section class="hero-section">
    <div class="hero-decor-1"></div>
    <div class="hero-decor-2"></div>
    <div class="hero-decor-3"></div>
    <div class="container px-6 mx-auto hero-inner">
      <div class="hero-badge">Association agréée depuis 1975</div>
      <h1 class="hero-title">{hero.title}</h1>
      <p class="hero-subtitle">{hero.subtitle}</p>
      <div class="hero-actions">
        <Button href={hero.cta.url} variant="accent" size="lg">
          {hero.cta.label}
        </Button>
        <a href="/about" class="hero-link">En savoir plus →</a>
      </div>
    </div>
    <div class="hero-wave">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="#f9fafb"></path>
      </svg>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats-section">
    <div class="container px-6 mx-auto">
      <div class="stats-grid">
        {
          stats.map((stat) => (
            <div class="stat-item">
              <span class="stat-valeur">{stat.valeur}</span>
              <span class="stat-label">{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- MISSIONS -->
  <section id="missions" class="missions-section">
    <div class="container px-6 mx-auto">
      <div class="section-header">
        <p class="section-label">Ce que nous faisons</p>
        <h2 class="section-title">Nos Domaines d'Intervention</h2>
        <p class="section-sub">Nous vous accompagnons dans tous vos litiges du quotidien.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {
          services.map((service) => (
            <a href={service.href} class="mission-card">
              <div class="mission-icon">{icones[service.icon]}</div>
              <h3 class="mission-title">{service.title}</h3>
              <p class="mission-desc">{service.desc}</p>
              <span class="mission-link">Découvrir →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- BANDEAU ENGAGEMENT -->
  <section class="engagement-section">
    <div class="container px-6 mx-auto">
      <div class="engagement-grid">
        <div class="engagement-text">
          <p class="section-label-light">Notre engagement</p>
          <h2 class="engagement-title">Une association indépendante à vos côtés</h2>
          <p class="engagement-desc">
            L'AFOC 34 agit depuis 1975 pour défendre les droits des consommateurs et des locataires
            de l'Hérault. Nos bénévoles vous accompagnent gratuitement dans vos démarches.
          </p>
          <ul class="engagement-list">
            <li>✓ Information sur vos droits</li>
            <li>✓ Accompagnement amiable</li>
            <li>✓ Représentation dans les commissions</li>
            <li>✓ Défense collective des consommateurs</li>
          </ul>
        </div>
        <div class="engagement-card">
          <p class="engagement-card-title">Nous contacter</p>
          <p class="engagement-card-info">📍 {siteData.contact.details.address}</p>
          <p class="engagement-card-info">📞 {siteData.contact.details.phone}</p>
          <p class="engagement-card-info">✉️ {siteData.contact.details.email}</p>
          <p class="engagement-card-info">🚊 {siteData.contact.details.access}</p>
          <a href="/contact" class="engagement-card-btn">Prendre contact</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PERMANENCES -->
  <section class="permanences-section">
    <div class="container px-6 mx-auto">
      <div class="section-header">
        <p class="section-label">Près de chez vous</p>
        <h2 class="section-title">{permanences.title}</h2>
        <p class="section-sub">{permanences.description}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {
          permanences.locations.map((loc) => (
            <div class="permanence-card">
              <div class="permanence-dot" />
              <h4 class="permanence-city">{loc.city}</h4>
              <p class="permanence-address">📍 {loc.address}</p>
              <p class="permanence-schedule">🕐 {loc.schedule}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-10 text-center">
        <Button href="/permanences" variant="outline">Voir les détails des permanences</Button>
      </div>
    </div>
  </section>

  <!-- CTA ADHESION -->
  <section class="cta-section">
    <div class="container px-6 mx-auto">
      <div class="cta-box">
        <div class="cta-decor-1"></div>
        <div class="cta-decor-2"></div>
        <div class="cta-content">
          <p class="section-label-light">Rejoignez-nous</p>
          <h2 class="cta-title">Soutenez l'AFOC 34, adhérez !</h2>
          <p class="cta-desc">
            Plus nous sommes nombreux, plus notre voix pèse face aux bailleurs et aux grandes
            entreprises.
          </p>
          <Button href="/adhesion" variant="accent">Comment adhérer ?</Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── HERO ── */
  .hero-section {
    background-color: var(--color-bleu);
    padding: 6rem 0 0;
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .hero-decor-1 {
    position: absolute;
    top: -80px;
    left: -80px;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
  }
  .hero-decor-2 {
    position: absolute;
    top: 40px;
    right: -60px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: var(--color-rouge);
    opacity: 0.12;
  }
  .hero-decor-3 {
    position: absolute;
    bottom: 60px;
    left: 30%;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    padding-bottom: 4rem;
  }
  .hero-badge {
    display: inline-block;
    background: rgba(240, 54, 72, 0.15);
    color: #fca5a5;
    border: 1px solid rgba(240, 54, 72, 0.3);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: #ffffff;
    font-weight: 800;
    line-height: 1.2;
    max-width: 800px;
    margin: 0 auto 1.25rem;
  }
  .hero-subtitle {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.1rem;
    max-width: 560px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .hero-link {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s;
  }
  .hero-link:hover {
    color: #ffffff;
  }
  .hero-wave {
    margin-bottom: -2px;
  }
  .hero-wave svg {
    display: block;
    width: 100%;
  }

  /* ── STATS ── */
  .stats-section {
    background: #f9fafb;
    padding: 2.5rem 0;
    border-bottom: 1px solid #e5e7eb;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    text-align: center;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
  }
  .stat-valeur {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-bleu);
  }
  .stat-label {
    font-size: 0.8rem;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  /* ── SECTION HEADERS ── */
  .missions-section {
    padding: 5rem 0;
    background: #ffffff;
  }
  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .section-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-rouge);
    margin-bottom: 0.5rem;
  }
  .section-label-light {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 0.5rem;
  }
  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--color-bleu);
    margin-bottom: 0.75rem;
  }
  .section-sub {
    color: #6b7280;
    font-size: 1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  /* ── MISSION CARDS ── */
  .mission-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #e8ecf0;
    border-radius: 12px;
    padding: 2rem;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
    position: relative;
    overflow: hidden;
  }
  .mission-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--color-rouge);
    transform: scaleY(0);
    transition: transform 0.2s ease;
    transform-origin: bottom;
  }
  .mission-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(27, 81, 98, 0.12);
    border-color: var(--color-bleu);
  }
  .mission-card:hover::before {
    transform: scaleY(1);
  }
  .mission-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .mission-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-bleu);
    margin-bottom: 0.75rem;
  }
  .mission-desc {
    font-size: 0.9rem;
    color: #6b7280;
    line-height: 1.7;
    flex: 1;
    margin-bottom: 1.25rem;
  }
  .mission-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-rouge);
  }

  /* ── ENGAGEMENT ── */
  .engagement-section {
    background: var(--color-bleu);
    padding: 5rem 0;
  }
  .engagement-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .engagement-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .engagement-desc {
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.8;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }
  .engagement-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .engagement-list li {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .engagement-card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    padding: 2rem;
    backdrop-filter: blur(4px);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .engagement-card-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }
  .engagement-card-info {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .engagement-card-btn {
    display: inline-block;
    margin-top: 0.75rem;
    background: var(--color-rouge);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.65rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    text-align: center;
    transition: opacity 0.2s;
  }
  .engagement-card-btn:hover {
    opacity: 0.9;
  }

  /* ── PERMANENCES ── */
  .permanences-section {
    padding: 5rem 0;
    background: #f9fafb;
  }
  .permanence-card {
    background: #ffffff;
    border: 1px solid #e8ecf0;
    border-radius: 12px;
    padding: 1.75rem;
    position: relative;
    transition: box-shadow 0.2s ease;
  }
  .permanence-card:hover {
    box-shadow: 0 8px 24px rgba(27, 81, 98, 0.1);
  }
  .permanence-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-rouge);
    margin-bottom: 1rem;
  }
  .permanence-city {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-bleu);
    margin-bottom: 0.6rem;
  }
  .permanence-address {
    font-size: 0.85rem;
    color: #6b7280;
    margin-bottom: 0.4rem;
    line-height: 1.5;
  }
  .permanence-schedule {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-bleu);
  }

  /* ── CTA ── */
  .cta-section {
    padding: 5rem 0;
    background: #ffffff;
  }
  .cta-box {
    background: var(--color-bleu);
    border-radius: 20px;
    padding: 4rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cta-decor-1 {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
  }
  .cta-decor-2 {
    position: absolute;
    bottom: -40px;
    left: -40px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: var(--color-rouge);
    opacity: 0.1;
  }
  .cta-content {
    position: relative;
    z-index: 1;
  }
  .cta-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 1rem;
  }
  .cta-desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1rem;
    max-width: 500px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .engagement-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .cta-box {
      padding: 2.5rem 1.5rem;
    }
  }
  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
