---
import Layout from '../layouts/Layout.astro';
import siteData from '../data/site.json';
import Button from '../components/UI/Button.astro';
import Card from '../components/UI/Card.astro';

const title = siteData.seo.defaultTitle;
const description = siteData.seo.defaultDescription;
const hero = siteData.hero;
const services = siteData.services;
const permanences = siteData.permanences;
---

<Layout title={title} description={description}>
  <section class="py-24 text-center text-white bg-bleu from-primary to-secondary">
    <div class="container px-6 mx-auto">
      <h1 class="mb-6 text-4xl font-extrabold leading-tight md:text-6xl">{hero.title}</h1>
      <p class="max-w-3xl mx-auto mb-10 text-lg md:text-2xl text-blue-50">{hero.subtitle}</p>
      <Button href={hero.cta.url} variant="accent" size="lg">
        {hero.cta.label}
      </Button>
    </div>
  </section>

  <section id="missions" class="container px-6 py-20 mx-auto">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold md:text-4xl text-blue">Nos Domaines d'Intervention</h2>
      <div class="w-20 h-1 mx-auto bg-accent"></div>
    </div>
    <div class="grid gap-8 md:grid-cols-3">
      {
        services.map((service) => (
          <Card>
            <div class="p-2">
              <h3 class="mb-4 text-2xl font-bold text-secondary">
                <a href={service.href} class="hover:underline">
                  {service.title}
                </a>
              </h3>
              <p class="leading-relaxed text-gray-700">{service.desc}</p>
            </div>
          </Card>
        ))
      }
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="container px-6 mx-auto">
      <div class="mb-12 text-center">
        <h2 class="text-3xl font-bold text-primary">{permanences.title}</h2>
        <p class="mt-2 text-gray-600">{permanences.description}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {
          permanences.locations.map((loc) => (
            <div class="p-6 bg-white border border-gray-200 shadow-sm rounded-xl">
              <h4 class="mb-2 text-xl font-bold text-accent">{loc.city}</h4>
              <p class="mb-3 text-sm italic text-gray-600">{loc.address}</p>
              <p class="font-medium text-gray-800">{loc.schedule}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-10 text-center">
        <Button href="/permanences" variant="outline">Voir les détails des permanences</Button>
      </div>
    </div>
  </section>

  <section class="container px-6 py-20 mx-auto text-center">
    <div class="p-12 text-white shadow-2xl bg-bleu from-primary to-secondary rounded-3xl">
      <h2 class="mb-6 text-3xl font-bold">Soutenez l'AFOC 34, adhérez !</h2>
      <p class="max-w-2xl mx-auto mb-8 text-xl opacity-90">
        Plus nous sommes nombreux, plus notre voix pèse face aux bailleurs et aux grandes
        entreprises.
      </p>
      <Button href="/adhesion" variant="accent">Comment adhérer ?</Button>
    </div>
  </section>
</Layout>
