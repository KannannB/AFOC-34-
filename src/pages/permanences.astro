---
import Layout from '../layouts/Layout.astro';
import siteData from '../data/site.json';

const { permanences } = siteData;

interface Permanence {
  city: string;
  address: string;
  schedule: string;
  lat: number;
  lng: number;
}

function mapUrlFor(loc: Permanence) {
  return (
    'https://www.google.com/maps/search/?api=1&query=' +
    encodeURIComponent(`${loc.address}, ${loc.city}`)
  );
}

function staticMapFor(loc: Permanence) {
  return `https://static-maps.yandex.ru/1.x/?lang=fr_FR&ll=${loc.lng},${loc.lat}&z=13&l=map&size=450,220&pt=${loc.lng},${loc.lat},pm2rdm`;
}
---

<Layout
  title="Permanences à Montpellier, Béziers et Sète"
  description="Consultez les horaires et adresses des permanences de l'AFOC 34 à Montpellier, Béziers et Sète pour rencontrer un conseiller près de chez vous."
>
  <!-- Hero -->
  <section class="hero-permanences">
    <div class="hero-inner">
      <p class="hero-label">Près de chez vous</p>

      <h1>{permanences.title}</h1>

      <p class="hero-sub">{permanences.description}</p>
    </div>
  </section>

  <!-- Permanences -->
  <section class="container px-6 py-20 mx-auto">
    <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
      {
        permanences.locations.map((loc) => (
          <article class="card-permanence">
            <div class="card-header">
              <div class="card-initial">{loc.city.charAt(0)}</div>

              <div>
                <p class="card-badge">Permanence</p>
                <h2 class="card-city">{loc.city}</h2>
              </div>
            </div>

            <div class="card-content">
              <div class="card-info">
                <p class="card-info-label">📍 Adresse</p>
                <p class="card-info-value">{loc.address}</p>
              </div>

              <div class="card-info">
                <p class="card-info-label">🕐 Horaires</p>
                <p class="card-info-value">{loc.schedule}</p>
              </div>
            </div>

            <div class="card-map">
              <img
                src={staticMapFor(loc)}
                width="450"
                height="220"
                loading="lazy"
                alt={`Plan d'accès à la permanence de ${loc.city}`}
                class="card-map-img"
              />
            </div>

            <a
              href={mapUrlFor(loc)}
              target="_blank"
              rel="noopener noreferrer"
              class="card-map-link"
            >
              📍 Itinéraire vers {loc.city} →
            </a>
          </article>
        ))
      }
    </div>

    <!-- Bandeau -->
    <div class="bandeau-info">
      <h3 class="bandeau-title">⚠️ Important</h3>

      <p class="bandeau-text">
        Les permanences peuvent être soumises à modification. Nous vous conseillons de nous
        contacter par téléphone au <strong>06 80 94 18 13</strong> avant de vous déplacer.
      </p>
    </div>
  </section>
</Layout>

<style>
  /* HERO */

  .hero-permanences {
    position: relative;
    overflow: hidden;
    background: var(--color-bleu);
    padding: 5rem 1.5rem 4rem;
  }

  .hero-permanences::before {
    content: '';
    position: absolute;
    right: -120px;
    top: -120px;
    width: 320px;
    height: 320px;
    background: var(--color-rouge);
    opacity: 0.08;
    border-radius: 50%;
  }

  .hero-inner {
    max-width: 760px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-label {
    color: var(--color-rouge);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .hero-permanences h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.1;
    color: white;
    margin-bottom: 1rem;
  }

  .hero-sub {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.05rem;
    line-height: 1.8;
    max-width: 620px;
  }

  /* CARDS */

  .card-permanence {
    background: white;
    border-radius: 24px;
    padding: 2rem;
    border: 1px solid #edf1f4;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .card-permanence:hover {
    transform: translateY(-6px);
    border-color: rgba(27, 81, 98, 0.25);
    box-shadow: 0 20px 40px rgba(27, 81, 98, 0.12);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .card-initial {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--color-bleu);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    font-family: var(--font-serif);
    font-weight: 800;
    flex-shrink: 0;
  }

  .card-badge {
    color: var(--color-rouge);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    margin-bottom: 0.3rem;
  }

  .card-city {
    color: var(--color-bleu);
    font-size: 1.5rem;
    font-family: var(--font-serif);
    font-weight: 700;
    line-height: 1.2;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .card-info {
    padding-bottom: 1.2rem;
    border-bottom: 1px solid #eef2f5;
  }

  .card-info:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .card-info-label {
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.72rem;
    font-weight: 700;
    margin-bottom: 0.45rem;
  }

  .card-info-value {
    color: #374151;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .card-map {
    margin-top: 1.25rem;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #edf1f4;
  }

  .card-map-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .card-map-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-bleu);
    text-decoration: none;
  }

  .card-map-link:hover {
    color: var(--color-rouge);
  }

  /* BANDEAU */

  .bandeau-info {
    margin-top: 4rem;
    background: rgba(27, 81, 98, 0.05);
    border-left: 5px solid var(--color-bleu);
    border-radius: 0 18px 18px 0;
    padding: 1.75rem 2rem;
  }

  .bandeau-title {
    font-family: var(--font-serif);
    color: var(--color-bleu);
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }

  .bandeau-text {
    color: #374151;
    line-height: 1.8;
    font-size: 0.95rem;
  }
</style>
