---
import Layout from '../layouts/Layout.astro';
import siteData from '../data/site.json';

const { permanences } = siteData;
---

<Layout
  title="Nos Permanences - AFOC 34"
  description="Trouvez une permanence de l'AFOC 34 à Montpellier, Béziers ou Sète."
>
  <section class="py-16">
    <div class="container mx-auto px-6">
      <h1 class="text-4xl font-bold text-primary mb-4">{permanences.title}</h1>
      <p class="text-lg text-gray-600 mb-12">{permanences.description}</p>

      <div class="grid md:grid-cols-3 gap-8">
        {
          permanences.locations.map((loc) => (
            <div class="border-2 border-gray-100 rounded-2xl p-8 hover:border-accent transition-colors">
              <div class="bg-accent text-white w-12 h-12 rounded-full flex items-center justify-center mb-6 font-bold text-xl">
                {loc.city.charAt(0)}
              </div>
              <h2 class="text-2xl font-bold mb-4">{loc.city}</h2>
              <div class="space-y-4">
                <div>
                  <p class="text-sm text-gray-500 uppercase font-bold">Adresse</p>
                  <p class="text-gray-800">{loc.address}</p>
                </div>
                <div>
                  <p class="text-sm text-gray-500 uppercase font-bold">Horaires</p>
                  <p class="text-gray-800 font-medium">{loc.schedule}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-16 bg-blue-50 p-8 rounded-2xl text-center">
        <h3 class="text-xl font-bold text-primary mb-4">Important</h3>
        <p>
          Les permanences peuvent être soumises à modification. Nous vous conseillons de nous
          contacter par téléphone au <strong>04 67 15 01 20</strong> avant de vous déplacer.
        </p>
      </div>
    </div>
  </section>
  <section class="py-12 container mx-auto px-6">
    <h2 class="text-3xl font-bold text-primary mb-8 text-center">Où nous trouver ?</h2>
    <div class="rounded-2xl overflow-hidden shadow-lg h-[450px] border-4 border-white">
      <iframe
        width="100%"
        height="100%"
        frameborder="0"
        scrolling="no"
        marginheight="0"
        marginwidth="0"
        src="https://www.openstreetmap.org/export/embed.html?bbox=3.85,43.59,3.92,43.62&layer=mapnik&marker=43.6015,3.8965"
        style="border: 0"
      >
      </iframe>
    </div>
    <p class="text-center mt-4 text-sm text-gray-500 italic">
      Cliquez sur la carte pour l'agrandir et calculer votre itinéraire.
    </p>
  </section>
</Layout>
