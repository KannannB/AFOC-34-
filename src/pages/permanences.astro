---
import Layout from '../layouts/Layout.astro';
import siteData from '../data/site.json';

const { permanences } = siteData;
const fullAddress = siteData.contact.details.address;

const mapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(fullAddress);
---

<Layout
  title="Nos Permanences - AFOC 34"
  description="Trouvez une permanence de l'AFOC 34 à Montpellier, Béziers ou Sète."
>
  <!-- Hero -->
  <section class="hero-permanences">
    <div class="hero-inner">
      <p class="hero-label">Près de chez vous</p>

      <h1>{permanences.title}</h1>

      <p class="hero-sub">{permanences.description}</p>
    </div>
  </section>

  <!-- Permanences -->
  <section class="container mx-auto px-6 py-20">
    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">
      {
        permanences.locations.map((loc) => (
          <article class="card-permanence">
            <div class="card-header">
              <div class="card-initial">{loc.city.charAt(0)}</div>

              <div>
                <p class="card-badge">Permanence</p>
                <h2 class="card-city">{loc.city}</h2>
              </div>
            </div>

            <div class="card-content">
              <div class="card-info">
                <p class="card-info-label">📍 Adresse</p>
                <p class="card-info-value">{loc.address}</p>
              </div>

              <div class="card-info">
                <p class="card-info-label">🕐 Horaires</p>
                <p class="card-info-value">{loc.schedule}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Bandeau -->
    <div class="bandeau-info">
      <h3 class="bandeau-title">⚠️ Important</h3>

      <p class="bandeau-text">
        Les permanences peuvent être soumises à modification. Nous vous conseillons de nous
        contacter par téléphone au <strong>04 67 15 01 20</strong> avant de vous déplacer.
      </p>
    </div>
  </section>

  <!-- Carte -->
  <section class="container mx-auto px-6 pb-20">
    <div class="section-header">
      <p class="section-label">Localisation</p>

      <h2 class="section-title">Où nous trouver ?</h2>
    </div>

    <div class="space-y-6">
      <div
        class="rounded-2xl overflow-hidden shadow-lg border-2 border-gray-100 bg-gray-200 h-[450px]"
      >
        <img
          src="https://static-maps.yandex.ru/1.x/?lang=fr_FR&ll=3.8965,43.6015&z=15&l=map&size=650,350&pt=3.8965,43.6015,pm2rdm"
          alt="Plan d'accès AFOC 34"
          class="w-full h-full object-cover"
        />
      </div>

      <div class="flex flex-col items-center gap-4">
        <a
          href={mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-[var(--color-bleu)] text-white px-8 py-4 rounded-full font-bold shadow-xl hover:bg-[var(--color-rouge)] hover:-translate-y-1 transition-all duration-300"
        >
          <span>📍 Cliquez pour ouvrir l'itinéraire</span>
        </a>

        <p class="text-xs text-gray-500 text-center max-w-xs italic">
          L'itinéraire s'ouvrira directement dans votre application GPS (Google Maps, Waze, Apple
          Maps).
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* HERO */

  .hero-permanences {
    position: relative;
    overflow: hidden;
    background: var(--color-bleu);
    padding: 5rem 1.5rem 4rem;
  }

  .hero-permanences::before {
    content: '';
    position: absolute;
    right: -120px;
    top: -120px;
    width: 320px;
    height: 320px;
    background: var(--color-rouge);
    opacity: 0.08;
    border-radius: 50%;
  }

  .hero-inner {
    max-width: 760px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-label {
    color: var(--color-rouge);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .hero-permanences h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.1;
    color: white;
    margin-bottom: 1rem;
  }

  .hero-sub {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.05rem;
    line-height: 1.8;
    max-width: 620px;
  }

  /* CARDS */

  .card-permanence {
    background: white;
    border-radius: 24px;
    padding: 2rem;
    border: 1px solid #edf1f4;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .card-permanence:hover {
    transform: translateY(-6px);
    border-color: rgba(27, 81, 98, 0.25);
    box-shadow: 0 20px 40px rgba(27, 81, 98, 0.12);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .card-initial {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--color-bleu);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    font-family: var(--font-serif);
    font-weight: 800;
    flex-shrink: 0;
  }

  .card-badge {
    color: var(--color-rouge);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    margin-bottom: 0.3rem;
  }

  .card-city {
    color: var(--color-bleu);
    font-size: 1.5rem;
    font-family: var(--font-serif);
    font-weight: 700;
    line-height: 1.2;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .card-info {
    padding-bottom: 1.2rem;
    border-bottom: 1px solid #eef2f5;
  }

  .card-info:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .card-info-label {
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.72rem;
    font-weight: 700;
    margin-bottom: 0.45rem;
  }

  .card-info-value {
    color: #374151;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  /* BANDEAU */

  .bandeau-info {
    margin-top: 4rem;
    background: rgba(27, 81, 98, 0.05);
    border-left: 5px solid var(--color-bleu);
    border-radius: 0 18px 18px 0;
    padding: 1.75rem 2rem;
  }

  .bandeau-title {
    font-family: var(--font-serif);
    color: var(--color-bleu);
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }

  .bandeau-text {
    color: #374151;
    line-height: 1.8;
    font-size: 0.95rem;
  }

  /* SECTION */

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-label {
    color: var(--color-rouge);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .section-title {
    color: var(--color-bleu);
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
  }
</style>
