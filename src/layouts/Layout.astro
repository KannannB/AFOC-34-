---
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer/Footer.astro';
import siteData from '../data/site.json';
import '../styles/global.css';
const { title, description, image } = Astro.props;
const pageTitle = title ? `${title} | ${siteData.header.logo}` : siteData.header.logo;
const pageDescription = description || siteData.seo.defaultDescription;
const pageImage = image || siteData.seo.ogImage;
const pageUrl = Astro.url.href;
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'AFOC 34',
  alternateName: "Association Force Ouvrière Consommateurs de l'Hérault",
  url: 'https://afoc34.fr',
  logo: 'https://afoc34.fr' + siteData.seo.ogImage,
  telephone: siteData.contact.details.phone,
  email: siteData.contact.details.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteData.contact.details.address,
    addressLocality: 'Montpellier',
    addressRegion: 'Hérault',
    addressCountry: 'FR',
  },
  areaServed: ['Montpellier', 'Béziers', 'Sète'],
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={siteData.seo.keywords} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#1b5162" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:site_name" content="AFOC 34" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageImage} />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9W263QYRTL"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-9W263QYRTL');
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
