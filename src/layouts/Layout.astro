---
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer/Footer.astro';
import siteData from '../data/site.json';
import '../styles/global.css';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${siteData.header.logo}` : siteData.header.logo}</title>
    <meta name="description" content={description || siteData.hero.subtitle} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#2563eb" />
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script></head
  >

  <script>
    const identity = window['netlifyIdentity'];
    if (identity) {
      identity.on('init', (user) => {
        if (!user) {
          identity.on('login', () => {
            document.location.href = '/admin/';
          });
        }
      });
    }
  </script>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
